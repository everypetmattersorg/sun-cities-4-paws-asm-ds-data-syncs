# Copy to .env and fill in for local runs. In GitHub Actions these are set
# as repository secrets instead (Settings -> Secrets and variables ->
# Actions) -- see README.md for the full list each workflow needs.

# --- ASM (Shelter Manager) ---
ASM_BASE_URL=https://us01d.sheltermanager.com
ASM_ACCOUNT=
ASM_USERNAME=
ASM_PASSWORD=

# --- DaySmart Vetter ---
DS_CLIENT_ID=
DS_CLIENT_SECRET=
DS_API_KEY=
DS_DOMAIN=
# Only needed by asm_to_daysmart_create_patients.py -- run it with
# --list-clients first to find this.
DS_SHELTER_CLIENT_ID=

# --- Email reports (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=

# --- Per-flow report recipients (comma-separated) ---
MICROCHIP_SYNC_REPORT_TO=
SPAY_NEUTER_SYNC_REPORT_TO=
PATIENT_PROFILE_SYNC_REPORT_TO=
VACCINATION_SYNC_REPORT_TO=
MEDICAL_NOTES_SYNC_REPORT_TO=
CREATE_PATIENTS_REPORT_TO=
